    collect_reviews:
      kind: join
      inputs:
        qwen: { contract: ReviewerResult }
        kimi: { contract: ReviewerResult }
        glm: { contract: ReviewerResult }
      outputs: { complete: {}, failed: {} }
      config:
        mode: all
        field: status
        success_values: [complete, failed]
        passed_port: complete
        failed_port: failed

    qwen_review:
      kind: agent
      agent: qwen_reviewer
      allowed_builtin_tools: [Read, Grep, Glob, LS]
      allowed_dag_tools: [handoff]
      workspace_access: { writable_paths: [], readonly_paths: [repository, review-evidence] }
      inputs: { context: { contract: ReviewContext } }
      outputs: { voted: { contract: VerificationVote }, failed: { contract: VerificationVote } }

    kimi_review:
      kind: agent
      agent: kimi_reviewer
      allowed_builtin_tools: [Read, Grep, Glob, LS]
      allowed_dag_tools: [handoff]
      workspace_access: { writable_paths: [], readonly_paths: [repository, review-evidence] }
      inputs: { context: { contract: ReviewContext } }
      outputs: { voted: { contract: VerificationVote }, failed: { contract: VerificationVote } }

    glm_review:
      kind: agent
      agent: glm_reviewer
      allowed_builtin_tools: [Read, Grep, Glob, LS]
      allowed_dag_tools: [handoff]
      workspace_access: { writable_paths: [], readonly_paths: [repository, review-evidence] }
      inputs: { context: { contract: ReviewContext } }
      outputs: { voted: { contract: VerificationVote }, failed: { contract: VerificationVote } }

    decide:
      kind: command
      depends_on: [collect_reviews, build_trusted_review_context]
      inputs:
        reviews: {}
        trusted: { contract: TrustedReviewContext }
      outputs: { decided: { contract: FinalReview }, failed: {} }
      config:
        command:
          - node
          - -e
          - |-
            let s='';const last=(input,key)=>Array.isArray(input[key])?input[key].at(-1):undefined,findingKey=finding=>['category','severity','title','file','line','evidence','recommendation','confidence'].map(field=>JSON.stringify(finding?.[field]??null)).join('\u0000');
            process.stdin.on('data',chunk=>s+=chunk).on('end',()=>{
              const input=JSON.parse(s),trusted=last(input,'trusted'),joined=last(input,'reviews'),reviews=Array.isArray(joined&&joined.values)?joined.values:[];
              if(!trusted||typeof trusted!=='object'||!trusted.coverage||typeof trusted.coverage!=='object'||reviews.length!==3)throw new Error('three normalized model reviews and trusted context are required');
              const identities=new Set(reviews.map(review=>review&&review.reviewer));
              if(identities.size!==3||!['qwen','kimi','glm'].every(id=>identities.has(id)))throw new Error('model review identities are invalid');
              const complete=reviews.filter(review=>review.status==='complete'&&(review.vote==='approve'||review.vote==='request_changes')),approvals=complete.filter(review=>review.vote==='approve').length,changes=complete.filter(review=>review.vote==='request_changes').length,abstentions=3-complete.length,selected=reviews.flatMap(review=>Array.isArray(review.findings)?review.findings:[]),seen=new Set(),findings=selected.filter(finding=>{if(!finding||typeof finding!=='object')return false;const key=findingKey(finding);if(seen.has(key))return false;seen.add(key);return true}),enoughEvidence=complete.length>=2,passed=enoughEvidence&&approvals>=2&&findings.length===0,status=findings.length>0?'findings':passed?'pass':'inconclusive',confidence=complete.length===3?'high':complete.length===2?'medium':'low',summary=`Three-model review: ${approvals} approve, ${changes} request changes, ${abstentions} abstain; ${findings.length} retained actionable finding${findings.length===1?'':'s'}.`,report={repo:trusted.repo,pr:trusted.pr,base:trusted.base,head:trusted.head,status,confidence,summary,coverage:trusted.coverage,actionable_count:findings.length,findings,reviewer_results:reviews},quorum={passed,successes:approvals,total:3,threshold:2};
              process.stdout.write(JSON.stringify({report,quorum}));
            });
        stdin_field: "$inputs"
        timeout_ms: 10000
        capture_limit: 700000
        success_port: decided
        failure_port: failed
        parse_stdout: json
        result_payload: value

    review_outcome:
      kind: condition
      inputs: { result: { contract: FinalReview } }
      outputs:
        accepted: { contract: FinalReview }
        rejected: { contract: FinalReview }
      config:
        field: quorum.passed
        routes:
          "true": accepted
          "false": rejected
        default: rejected

    done:
      kind: terminal
      outcome: success
      inputs: { result: { contract: FinalReview } }

    blocked:
      kind: terminal
      outcome: cancelled
      inputs: { result: { contract: FinalReview } }

    preparation_failed:
      kind: terminal
      outcome: failure
      inputs: { result: {} }

    context_redaction_failed:
      kind: terminal
      outcome: failure
      inputs: { result: {} }

    trusted_context_failed:
      kind: terminal
      outcome: failure
      inputs: { result: {} }

    review_collection_failed:
      kind: terminal
      outcome: failure
      inputs: { result: {} }

    decision_failed:
      kind: terminal
      outcome: failure
      inputs: { result: {} }

  edges:
    - { from: $run.input, to: prepare.request }
    - { from: prepare.ready, to: build_review_context.prepared }
    - { from: prepare.ready, to: build_trusted_review_context.prepared }
    - { from: prepare.failed, to: preparation_failed.result, condition: on_failure }
    - { from: build_review_context.failed, to: context_redaction_failed.result, condition: on_failure }
    - { from: build_trusted_review_context.failed, to: trusted_context_failed.result, condition: on_failure }
    - { from: build_review_context.ready, to: qwen_review.context }
    - { from: build_review_context.ready, to: kimi_review.context }
    - { from: build_review_context.ready, to: glm_review.context }
    - { from: build_trusted_review_context.trusted, to: normalize_qwen_review.trusted }
    - { from: build_trusted_review_context.trusted, to: normalize_kimi_review.trusted }
    - { from: build_trusted_review_context.trusted, to: normalize_glm_review.trusted }
    - { from: build_trusted_review_context.trusted, to: decide.trusted }
    - { from: qwen_review.voted, to: normalize_qwen_review.success }
    - { from: qwen_review.failed, to: normalize_qwen_review.failure, condition: on_failure }
    - { from: kimi_review.voted, to: normalize_kimi_review.success }
    - { from: kimi_review.failed, to: normalize_kimi_review.failure, condition: on_failure }
    - { from: glm_review.voted, to: normalize_glm_review.success }
    - { from: glm_review.failed, to: normalize_glm_review.failure, condition: on_failure }
    - { from: normalize_qwen_review.reviewed, to: collect_reviews.qwen }
    - { from: normalize_kimi_review.reviewed, to: collect_reviews.kimi }
    - { from: normalize_glm_review.reviewed, to: collect_reviews.glm }
    - { from: collect_reviews.complete, to: decide.reviews }
    - { from: collect_reviews.failed, to: review_collection_failed.result, condition: on_failure }
    - { from: decide.decided, to: review_outcome.result }
    - { from: decide.failed, to: decision_failed.result, condition: on_failure }
    - { from: review_outcome.accepted, to: done.result }
    - { from: review_outcome.rejected, to: blocked.result }

  policies:
    max_nodes: 19
    max_edges: 32
    max_parallelism: 3
    max_dispatches: 16
    max_handoffs: 24
    max_corrections_per_node: 2
