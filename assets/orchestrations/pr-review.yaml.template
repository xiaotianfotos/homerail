  nodes:
    prepare:
      kind: command
      inputs: { request: { contract: RunEnvelope } }
      outputs: { ready: { contract: PreparedReviewContext }, failed: {} }
      config:
        command:
          - node
          - -e
          - |-
            const { spawnSync } = require('node:child_process');
            const { createHash } = require('node:crypto');
            const { existsSync, mkdirSync, readFileSync, writeFileSync } = require('node:fs');
            let stdin = '';
            const fail = (message) => { throw new Error(message); };
            const exactRevision = /^(?:[0-9a-f]{40}|[0-9a-f]{64})$/i;
            const canonicalCoverage = (files) => {
              const unique = [];
              const seen = new Set();
              for (const file of files) {
                if (typeof file !== 'string') continue;
                const normalized = file.trim();
                if (!normalized || seen.has(normalized)) continue;
                seen.add(normalized);
                unique.push(normalized);
              }
              unique.sort();
              return {
                digest: createHash('sha256').update(unique.join('\n')).digest('hex'),
                count: unique.length,
              };
            };
            const secureUrl = (value) => {
              if (typeof value !== 'string') fail('repository URL is missing');
              let parsed;
              try { parsed = new URL(value); } catch { fail('repository URL is invalid'); }
              if (
                parsed.protocol !== 'https:' || parsed.username || parsed.password ||
                !parsed.hostname || parsed.search || parsed.hash ||
                !/^\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+\.git$/.test(parsed.pathname)
              ) fail('repository URL must be credential-free HTTPS');
              return value;
            };
            const gitEnv = () => {
              const env = {};
              for (const key of [
                'PATH', 'Path', 'PATHEXT', 'SystemRoot', 'WINDIR', 'COMSPEC',
                'TMP', 'TEMP', 'TMPDIR', 'LANG', 'LC_ALL', 'SSL_CERT_FILE',
                'SSL_CERT_DIR', 'HTTPS_PROXY', 'HTTP_PROXY', 'NO_PROXY',
                'https_proxy', 'http_proxy', 'no_proxy',
              ]) if (typeof process.env[key] === 'string') env[key] = process.env[key];
              return {
                ...env,
                HOME: process.cwd(),
                USERPROFILE: process.cwd(),
                XDG_CONFIG_HOME: process.cwd() + '/.config',
                GIT_CONFIG_NOSYSTEM: '1',
                GIT_CONFIG_GLOBAL: process.platform === 'win32' ? 'NUL' : '/dev/null',
                GIT_ASKPASS: '',
                SSH_ASKPASS: '',
                GIT_TERMINAL_PROMPT: '0',
                GCM_INTERACTIVE: 'Never',
              };
            };
            const run = (args) => {
              const common = [
                '-c', 'credential.helper=', '-c', 'http.extraHeader=',
                '-c', 'core.hooksPath=/dev/null', '-c', 'protocol.file.allow=never',
                '-c', 'protocol.ext.allow=never',
              ];
              const result = spawnSync('git', [...common, ...args], {
                encoding: 'utf8', env: gitEnv(), maxBuffer: 67108864,
              });
              if (result.error) throw result.error;
              if (result.status !== 0) {
                fail(String(result.stderr || result.stdout || ('git exited ' + result.status)).trim());
              }
              return String(result.stdout || '');
            };
            process.stdin.on('data', (chunk) => { stdin += chunk; }).on('end', () => {
              const inputs = JSON.parse(stdin);
              const request = Array.isArray(inputs.request) ? inputs.request.at(-1) : undefined;
              const payload = request?.payload;
              if (!payload || typeof payload !== 'object') fail('review input payload is missing');
              const { repo, pr, base, head, title, author } = payload;
              if (
                typeof repo !== 'string' || !Number.isInteger(pr) ||
                typeof base !== 'string' || typeof head !== 'string' ||
                !exactRevision.test(base) || !exactRevision.test(head)
              ) fail('invalid pull request checkout input');
              const baseUrl = secureUrl(payload.base_clone_url);
              const headUrl = secureUrl(payload.head_clone_url);
              if (existsSync('repository')) fail('run workspace repository path already exists');
              run(['clone', '--no-checkout', '--', baseUrl, 'repository']);
              run(['-C', 'repository', 'fetch', '--no-tags', '--force', 'origin', base]);
              const headRemote = headUrl === baseUrl ? 'origin' : 'homerail-head';
              if (headRemote !== 'origin') run(['-C', 'repository', 'remote', 'add', headRemote, headUrl]);
              run(['-C', 'repository', 'fetch', '--no-tags', '--force', headRemote, head]);
              run(['-C', 'repository', 'cat-file', '-e', base + '^{commit}']);
              run(['-C', 'repository', 'cat-file', '-e', head + '^{commit}']);
              run(['-C', 'repository', 'checkout', '--detach', head]);
              const resolved = run(['-C', 'repository', 'rev-parse', '--verify', 'HEAD^{commit}']).trim();
              if (resolved.toLowerCase() !== head.toLowerCase()) {
                fail('checked out HEAD does not equal the requested head revision');
              }
              const names = run([
                '-C', 'repository', 'diff', '--name-only', '-z', '--no-ext-diff', base + '...' + head,
              ]);
              const changed = names ? names.split('\0').filter(Boolean) : [];
              if (changed.length > 5000) fail('pull request changes more than 5000 files');
              if (Buffer.byteLength(JSON.stringify(changed), 'utf8') > 150000) {
                fail('changed file list exceeds the review input limit');
              }
              const coverage = canonicalCoverage(changed);
              const diffStat = run([
                '-C', 'repository', 'diff', '--shortstat', '--no-ext-diff', base + '...' + head,
              ]).trim();
              if (diffStat.length > 20000) fail('diff summary exceeds the review input limit');
              const rawPatch = run([
                '-C', 'repository', 'diff', '--no-ext-diff', '--no-color', '--unified=80',
                base + '...' + head, '--',
              ]);
              const commitCount = Number(run([
                '-C', 'repository', 'rev-list', '--count', base + '..' + head,
              ]).trim());
              if (!Number.isSafeInteger(commitCount) || commitCount < 0) {
                fail('invalid pull request commit count');
              }
              const rawCommitMetadata = run([
                '-C', 'repository', 'log', '-z', '--max-count=250',
                '--format=%H%x00%an%x00%ae%x00%cn%x00%ce%x00%s',
                base + '..' + head, '--',
              ]);
              const metadataFields = rawCommitMetadata.split('\0');
              while (metadataFields.at(-1) === '') metadataFields.pop();
              if (metadataFields.length % 6 !== 0) fail('invalid pull request commit metadata');
              const cleanMetadata = (value, limit) => String(value || '')
                .replace(/[\u0000-\u001f\u007f]+/g, ' ').trim().slice(0, limit);
              const commitMetadata = [];
              for (let offset = 0; offset < metadataFields.length; offset += 6) {
                const commit = cleanMetadata(metadataFields[offset], 64);
                if (!exactRevision.test(commit)) fail('invalid pull request commit metadata revision');
                commitMetadata.push({
                  commit,
                  author_name: cleanMetadata(metadataFields[offset + 1], 500),
                  author_email: cleanMetadata(metadataFields[offset + 2], 500),
                  committer_name: cleanMetadata(metadataFields[offset + 3], 500),
                  committer_email: cleanMetadata(metadataFields[offset + 4], 500),
                  subject: cleanMetadata(metadataFields[offset + 5], 1000),
                });
              }
              const chunkLimit = 120000;
              const evidenceLimit = 48 * 1024 * 1024;
              const rawPatchBytes = Buffer.byteLength(rawPatch, 'utf8');
              const splitByBytes = (value, limit) => {
                const chunks = [];
                let chunk = '';
                let bytes = 0;
                const flush = () => {
                  if (!chunk) return;
                  chunks.push(chunk);
                  chunk = '';
                  bytes = 0;
                };
                for (const line of value.match(/[^\n]*\n|[^\n]+$/g) || []) {
                  const lineBytes = Buffer.byteLength(line, 'utf8');
                  if (lineBytes <= limit) {
                    if (bytes > 0 && bytes + lineBytes > limit) flush();
                    chunk += line;
                    bytes += lineBytes;
                    continue;
                  }
                  flush();
                  for (const character of line) {
                    const characterBytes = Buffer.byteLength(character, 'utf8');
                    if (bytes > 0 && bytes + characterBytes > limit) flush();
                    chunk += character;
                    bytes += characterBytes;
                  }
                }
                flush();
                return chunks;
              };
              const boundedPatch = rawPatchBytes > evidenceLimit
                ? splitByBytes(rawPatch, evidenceLimit)[0] || ''
                : rawPatch;
              const diffTruncated = rawPatchBytes > evidenceLimit;
              const sections = boundedPatch
                ? boundedPatch.split(/(?=^diff --git )/m).filter(Boolean)
                : [];
              const evidenceDir = 'review-evidence';
              if (existsSync(evidenceDir)) fail('run workspace review evidence path already exists');
              mkdirSync(evidenceDir, { mode: 0o700 });
              const groupedChunks = [];
              let groupedContent = '';
              let groupedBytes = 0;
              let groupedFiles = [];
              const flushGroupedChunk = () => {
                if (!groupedContent) return;
                groupedChunks.push({ content: groupedContent, files: groupedFiles });
                groupedContent = '';
                groupedBytes = 0;
                groupedFiles = [];
              };
              for (let sectionIndex = 0; sectionIndex < sections.length; sectionIndex += 1) {
                const files = sections.length === changed.length && changed[sectionIndex]
                  ? [changed[sectionIndex]]
                  : [];
                for (const content of splitByBytes(sections[sectionIndex], chunkLimit)) {
                  const contentBytes = Buffer.byteLength(content, 'utf8');
                  if (groupedBytes > 0 && groupedBytes + contentBytes > chunkLimit) {
                    flushGroupedChunk();
                  }
                  groupedContent += content;
                  groupedBytes += contentBytes;
                  for (const file of files) {
                    if (!groupedFiles.includes(file)) groupedFiles.push(file);
                  }
                  if (groupedBytes >= chunkLimit) flushGroupedChunk();
                }
              }
              flushGroupedChunk();
              if (groupedChunks.length > 512) fail('diff evidence requires more than 512 chunks');
              const diffChunks = groupedChunks.map(({ content, files }, offset) => {
                const index = offset + 1;
                const chunkPath = `review-evidence/diff-${String(index).padStart(4, '0')}.patch`;
                writeFileSync(chunkPath, content, { encoding: 'utf8', mode: 0o600 });
                return {
                  index,
                  path: chunkPath,
                  bytes: Buffer.byteLength(content, 'utf8'),
                  files,
                };
              });
              const inlinePreview = diffChunks.length > 0
                ? readFileSync(diffChunks[0].path, 'utf8')
                : '';
              const continuation = diffChunks.length > 1
                ? `\n... [HomeRail full diff continues in ${diffChunks.length} review-evidence chunks]\n`
                : '';
              const truncation = diffTruncated
                ? '\n... [HomeRail diff evidence truncated at the 48 MiB safety limit]\n'
                : '';
              const context = {
                repo, pr, base, head,
                repository_path: '/workspace/repository',
                changed_files: changed,
                coverage,
                diff_stat: diffStat,
                diff_patch: inlinePreview + continuation + truncation,
                diff_chunks: diffChunks,
                diff_bytes: rawPatchBytes,
                diff_truncated: diffTruncated,
                commit_metadata: commitMetadata,
                commit_metadata_truncated: commitCount > commitMetadata.length,
              };
              if (typeof title === 'string') context.title = title;
              if (typeof author === 'string') context.author = author;
              const output = JSON.stringify(context);
              if (Buffer.byteLength(output, 'utf8') > 900000) {
                fail('review context exceeds the command capture limit');
              }
              process.stdout.write(output);
            });
        stdin_field: "$inputs"
        cwd: "$run_workspace"
        timeout_ms: 300000
        capture_limit: 1000000
        success_port: ready
        failure_port: failed
        parse_stdout: json
        result_payload: value

    build_review_context:
      kind: command
      depends_on: [prepare]
      inputs: { prepared: { contract: PreparedReviewContext } }
      outputs: { ready: { contract: ReviewContext }, failed: {} }
      config:
        command:
          - node
          - -e
          - |-
            let s='';
            process.stdin.on('data',chunk=>s+=chunk).on('end',()=>{
              const input=JSON.parse(s),prepared=Array.isArray(input.prepared)?input.prepared.at(-1):undefined;
              if(!prepared||typeof prepared!=='object')throw new Error('prepared review context is missing');
              const {commit_metadata,commit_metadata_truncated,changed_files,...review}=prepared;
              if(!Array.isArray(changed_files)||!review.coverage||typeof review.coverage!=='object'||typeof review.coverage.digest!=='string'||typeof review.coverage.count!=='number')throw new Error('trusted review coverage is missing');
              process.stdout.write(JSON.stringify(review));
            });
        stdin_field: "$inputs"
        timeout_ms: 10000
        capture_limit: 1000000
        success_port: ready
        failure_port: failed
        parse_stdout: json
        result_payload: value

    build_trusted_review_context:
      kind: command
      depends_on: [prepare]
      inputs: { prepared: { contract: PreparedReviewContext } }
      outputs: { trusted: { contract: TrustedReviewContext }, failed: {} }
      config:
        command:
          - node
          - -e
          - |-
            let s='';
            process.stdin.on('data',chunk=>s+=chunk).on('end',()=>{
              const input=JSON.parse(s),prepared=Array.isArray(input.prepared)?input.prepared.at(-1):undefined;
              if(!prepared||typeof prepared!=='object')throw new Error('prepared review context is missing');
              const {commit_metadata,commit_metadata_truncated,...trusted}=prepared;
              if(!Array.isArray(trusted.changed_files)||!trusted.coverage||typeof trusted.coverage!=='object')throw new Error('trusted review coverage is missing');
              process.stdout.write(JSON.stringify(trusted));
            });
        stdin_field: "$inputs"
        timeout_ms: 10000
        capture_limit: 1000000
        success_port: trusted
        failure_port: failed
        parse_stdout: json
        result_payload: value

    normalize_qwen_review:
      kind: command
      depends_on: [qwen_review, build_trusted_review_context]
      inputs:
        success: { contract: VerificationVote }
        failure: {}
        trusted: { contract: TrustedReviewContext }
        evidence: { contract: ReviewEvidenceState }
      outputs: { reviewed: { contract: ReviewerResult } }
      config:
        command:
          - node
          - -e
          - |-
            let s='';const reviewer=process.argv[1];const reviewerNode=process.argv[2]||reviewer;
            const last=(input,key)=>Array.isArray(input[key])?input[key].at(-1):undefined;
            const text=value=>{if(typeof value==='string')return value;try{return JSON.stringify(value)}catch{return String(value)}};
            const bounded=(value,limit)=>{const t=text(value);return t.length>limit?t.slice(0,limit):t};
            const findingKey=finding=>[finding&&finding.file,finding&&finding.line,finding&&finding.title].join(':');
            const validFinding=finding=>Boolean(finding&&typeof finding==='object'&&typeof finding.title==='string'&&finding.title.length>0&&typeof finding.file==='string'&&finding.file.length>0&&Number.isInteger(finding.line)&&finding.line>0);
            const publicFinding=f=>f&&typeof f==='object'?{category:f.category,severity:f.severity,title:f.title,file:f.file,line:f.line,evidence:f.evidence,recommendation:f.recommendation,confidence:f.confidence}:f;
            const parseState=value=>value==='valid'?'parsed':value==='invalid'?'parse_failed':value==='missing'?'missing':null;
            const contractStage=value=>value==='tool_arguments'?'handoff_shape':value==='contract_validation'||value==='handoff_applied'?'contract_validated':null;
            process.stdin.on('data',chunk=>s+=chunk).on('end',()=>{
              const input=JSON.parse(s);
              const trusted=last(input,'trusted');
              const evidence=last(input,'evidence');
              const success=last(input,'success');
              const failure=last(input,'failure');
              if(!trusted||typeof trusted!=='object'||!Array.isArray(trusted.changed_files)||!trusted.coverage||typeof trusted.coverage!=='object')throw new Error('trusted review context is missing');
              const changed=trusted.changed_files;
              const canonicalCoverageCount=(files)=>{const unique=[];const seen=new Set();for(const file of files){if(typeof file!=='string')continue;const normalized=file.trim();if(!normalized||seen.has(normalized))continue;seen.add(normalized);unique.push(normalized)}return unique.length};
              const candidate=success&&typeof success==='object'?success:(failure&&typeof failure==='object'?failure:null);
              const attestation=candidate&&typeof candidate==='object'&&candidate.coverage&&typeof candidate.coverage==='object'?candidate.coverage:null;
              const coverageValid=Boolean(attestation&&typeof attestation.digest==='string'&&attestation.digest===trusted.coverage.digest&&attestation.count===trusted.coverage.count&&trusted.coverage.count===canonicalCoverageCount(changed));
              const evidenceValid=!evidence||(typeof evidence==='object'&&(!evidence.reviewer||evidence.reviewer===reviewerNode));
              const projectionTruncated=Boolean(evidenceValid&&evidence&&evidence.projection_truncated===true);
              const attempts=(evidenceValid&&evidence&&Array.isArray(evidence.attempt_diagnostics))?evidence.attempt_diagnostics.filter(attempt=>attempt&&typeof attempt==='object'&&Number.isInteger(attempt.attempt)&&attempt.attempt>=1):[];
              const accepted=(evidenceValid&&evidence&&Array.isArray(evidence.accepted_findings))?evidence.accepted_findings.filter(validFinding):[];
              const seen=new Set();
              const findings=accepted.filter(finding=>{const key=findingKey(finding);if(seen.has(key))return false;seen.add(key);return true});
              const candidateFindings=candidate&&Array.isArray(candidate.findings)?candidate.findings.filter(validFinding):[];
              for(const finding of candidateFindings){const key=findingKey(finding);if(!seen.has(key)){seen.add(key);findings.push(finding)}}
              const lastAttempt=attempts[attempts.length-1];
              const complete=Boolean(candidate&&candidate.reviewer===reviewer&&candidate.status==='complete'&&(candidate.vote==='approve'||(candidate.vote==='request_changes'&&findings.length>0))&&coverageValid);
              const resolvedVote=complete&&findings.length>0?'request_changes':candidate&&candidate.vote;
              const explicitAbstain=Boolean(candidate&&candidate.reviewer===reviewer&&candidate.status==='failed'&&candidate.vote==='abstain');
              const inconsistentVote=Boolean(candidate&&candidate.reviewer===reviewer&&candidate.status==='complete'&&candidate.vote==='request_changes'&&findings.length===0);
              const reportedCategory=complete?'accepted':(lastAttempt&&typeof lastAttempt.failure_category==='string')?lastAttempt.failure_category:inconsistentVote?'contract_validation_failed':explicitAbstain?'reviewer_abstained':'unknown';
              const category=!complete&&reportedCategory==='reviewer_abstained'&&(!coverageValid||projectionTruncated)?'unknown':reportedCategory;
              const failureCategories=new Set(['provider_output_truncated','handoff_arguments_invalid','contract_validation_failed','transport_failed','unknown']);
              const evidenceTruncated=projectionTruncated||failureCategories.has(category);
              const message=(failure&&typeof failure==='object'&&typeof failure.error==='string'?failure.error:lastAttempt&&typeof lastAttempt.message==='string'?lastAttempt.message:inconsistentVote?'request_changes vote requires at least one retained finding':'reviewer ended without a complete vote');
              const diagnostics=(attempts.length>0?attempts.slice(0,8):[{attempt:1,failure_category:category,message:inconsistentVote?'request_changes vote requires at least one retained finding':undefined}]).map(d=>{const diagnosticCategory=d.failure_category??d.category??category;return{attempt:d.attempt,category:!complete&&diagnosticCategory==='reviewer_abstained'&&(!coverageValid||projectionTruncated)?'unknown':diagnosticCategory,finish_reason:d.finish_reason??null,output_tokens:d.output_tokens??null,output_token_limit:d.output_token_limit??null,tool_arguments_parse_state:parseState(d.tool_argument_parse_state),contract_validation_stage:contractStage(d.contract_stage),message:d.message??null}});
              if(complete&&(diagnostics.at(-1)?.category||'')!=='accepted'&&diagnostics.length<8)diagnostics.push({attempt:(Number(diagnostics.at(-1)?.attempt)||0)+1,category:'accepted',finish_reason:null,output_tokens:null,output_token_limit:null,tool_arguments_parse_state:null,contract_validation_stage:null,message:null});
              const summary=(complete||explicitAbstain)?bounded(candidate&&candidate.summary?candidate.summary:'',12000):`${reviewer} reviewer did not complete a valid vote (${category})`+(message?': '+bounded(message,300):'');
