      credentials:
        - credential_ref: github-autofix
          purpose: independently confirm a clean revised review on the same Draft PR head
          inject:
            mode: manager_broker
            broker: github_pr
            allowed_actions: [pull_request_snapshot, read_diff, read_file, assess_review]
      inputs: { prior: { contract: ReviewDecision } }
      outputs:
        reviewed:
          contract: ReviewDecision
          required_broker_actions:
            - credential_ref: github-autofix
              broker: github_pr
              action: pull_request_snapshot
              result_binding: { result_field: head_sha, content_field: head_sha }
            - credential_ref: github-autofix
              broker: github_pr
              action: assess_review
              result_digest_binding: { result_field: findings_sha256, content_field: findings }
            - credential_ref: github-autofix
              broker: github_pr
              action: assess_review
              result_binding: { result_field: coverage_ratio, content_field: quality.coverage_ratio }
            - credential_ref: github-autofix
              broker: github_pr
              action: assess_review
              result_binding: { result_field: coverage_complete, content_field: quality.coverage_complete }
            - credential_ref: github-autofix
              broker: github_pr
              action: assess_review
              result_binding: { result_field: test_report_sha256, content_field: quality.test_report_sha256 }
            - credential_ref: github-autofix
              broker: github_pr
              action: assess_review
              result_binding: { result_field: defect_load, content_field: quality.defect_load }
            - credential_ref: github-autofix
              broker: github_pr
              action: assess_review
              result_binding: { result_field: score, content_field: quality.score }
            - credential_ref: github-autofix
              broker: github_pr
              action: assess_review
              result_binding: { result_field: status, content_field: quality.status }
