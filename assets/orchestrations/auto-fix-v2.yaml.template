    final_confirmation_pair:
      kind: join
      inputs: { initial: {}, revision: {} }
      outputs: { ready: {}, invalid: {} }
      config:
        mode: any
        field: passed
        success_values: [true]
        passed_port: ready
        failed_port: invalid

    verify_confirmation:
      kind: command
      inputs: { reviews: {} }
      outputs: { ready: { contract: ReviewDecision }, failed: {} }
      config:
        command:
          - node
          - -e
          - >-
            let s='';const fail=m=>{throw new Error(m)},last=(inputs,key)=>Array.isArray(inputs[key])?inputs[key].at(-1):undefined;process.stdin.on('data',d=>s+=d).on('end',()=>{const inputs=JSON.parse(s),selected=last(inputs,'reviews'),pair=Array.isArray(selected?.values)?selected.values[0]:undefined,reviews=Array.isArray(pair?.values)?pair.values:[],prior=reviews[0],confirmation=reviews[1];if(reviews.length!==2||!prior||!confirmation||prior.verdict!=='clean'||confirmation.verdict!=='clean'||prior?.quality?.status!=='clean'||confirmation?.quality?.status!=='clean')fail('two clean reviews are required');if(prior.head_sha!==confirmation.head_sha)fail('clean reviews do not bind the same head');if(prior.quality.test_report_sha256!==confirmation.quality.test_report_sha256)fail('clean reviews do not bind the same test report');process.stdout.write(JSON.stringify(confirmation))});
        cwd: $run_workspace
        stdin_field: $inputs
        timeout_ms: 30000
        parse_stdout: json
        result_payload: value
        success_port: ready
        failure_port: failed

    finalize_ready:
      kind: command
      inputs: { decision: {} }
      outputs: { ready: { contract: AutoFixV2Result }, failed: {} }
      config:
        command:
          - node
          - -e
          - >-
            const fs=require('fs'),crypto=require('crypto');let s='';const fail=m=>{throw new Error(m)};process.stdin.on('data',d=>s+=d).on('end',()=>{const inputs=JSON.parse(s),review=Array.isArray(inputs.decision)?inputs.decision.at(-1):undefined;if(!review||review.verdict!=='clean'||review?.quality?.status!=='clean')fail('final clean review is missing');const task=fs.readFileSync(process.argv[1]),planBytes=fs.readFileSync(process.argv[2]),plan=JSON.parse(planBytes),pr=JSON.parse(fs.readFileSync(process.argv[3],'utf8')),sha=b=>crypto.createHash('sha256').update(b).digest('hex'),taskSha=sha(task),planSha=sha(planBytes);if(plan.task_document_sha256!==taskSha||pr.task_document_sha256!==taskSha)fail('final task identity mismatch');process.stdout.write(JSON.stringify({version:1,status:'ready_for_ci',repository:`${pr.owner}/${pr.repo}`,pull_number:pr.pull_number,head_sha:review.head_sha,task_document_sha256:taskSha,task_plan_sha256:planSha,review_confirmation_count:2,findings:review.findings,findings_sha256:review.quality.findings_sha256,test_report_sha256:review.quality.test_report_sha256,quality_score:review.quality.score,review_summary:review.summary}))});
          - $run_input/task_document
          - $run_input/task_plan
          - $run_input/pr_context
        cwd: $run_workspace
        stdin_field: $inputs
        timeout_ms: 30000
        parse_stdout: json
        result_payload: value
        success_port: ready
        failure_port: failed

    ready_for_ci: { kind: terminal, outcome: success, inputs: { result: { contract: AutoFixV2Result } } }
    preparation_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    aggregation_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    initial_review_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    initial_confirmation_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    revision_review_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    revision_confirmation_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    finalization_failed: { kind: terminal, outcome: failure, inputs: { result: {} } }
    decision_missing:
      kind: terminal
      outcome: failure
      inputs:
        join: {}
        unexpected_clean: {}
        initial_confirmation: {}
        revision_confirmation: {}
        final_confirmation: {}
        confirmation: {}
    needs_human:
      kind: terminal
      outcome: cancelled
      inputs:
        exhausted: {}
        implementation: {}
        fix: {}

  edges:
    - { from: $run.input, to: prepare_repository.start }
    - { from: prepare_repository.ready, to: implement.plan }
    - { from: prepare_repository.failed, to: preparation_failed.result, condition: on_failure }
    - { from: implement.implemented, to: aggregate.workers }
    - { from: implement.failed, to: needs_human.implementation, condition: on_failure }
    - { from: aggregate.candidate, to: review_initial.candidate }
    - { from: aggregate.failed, to: aggregation_failed.result, condition: on_failure }
    - { from: review_initial.reviewed, to: initial_quality_gate.review }
    - { from: review_initial.failed, to: initial_review_failed.result, condition: on_failure }
    - { from: initial_quality_gate.clean, to: confirm_initial.prior }
    - { from: initial_quality_gate.clean, to: initial_confirmation_pair.prior }
    - { from: initial_quality_gate.fix, to: fix_request_join.initial }
    - { from: confirm_initial.reviewed, to: initial_confirmation_gate.review }
    - { from: confirm_initial.failed, to: initial_confirmation_failed.result, condition: on_failure }
    - { from: initial_confirmation_gate.clean, to: initial_confirmation_pair.confirmation }
    - { from: initial_confirmation_gate.fix, to: fix_request_join.initial_confirmation }
    - { from: fix_request_join.ready, to: fix_round_gate.state }
    - { from: fix_request_join.missing, to: decision_missing.join }
    - { from: fix_round_gate.fix, to: fix.review }
    - { from: fix_round_gate.unexpected_clean, to: decision_missing.unexpected_clean }
    - { from: fix_round_gate.exhausted, to: needs_human.exhausted }
    - { from: fix.fixed, to: review_revision.fixes }
    - { from: fix.failed, to: needs_human.fix, condition: on_failure }
    - { from: review_revision.reviewed, to: revision_quality_gate.review }
    - { from: review_revision.failed, to: revision_review_failed.result, condition: on_failure }
    - { from: revision_quality_gate.clean, to: confirm_revision.prior }
    - { from: revision_quality_gate.clean, to: revision_confirmation_pair.prior }
    - kind: feedback
      from: revision_quality_gate.fix
      to: fix_round_gate.state
      max_traversals: 4
    - { from: confirm_revision.reviewed, to: revision_confirmation_gate.review }
    - { from: confirm_revision.failed, to: revision_confirmation_failed.result, condition: on_failure }
    - { from: revision_confirmation_gate.clean, to: revision_confirmation_pair.confirmation }
    - kind: feedback
      from: revision_confirmation_gate.fix
      to: fix_round_gate.state
      max_traversals: 4
    - { from: initial_confirmation_pair.ready, to: final_confirmation_pair.initial }
    - { from: initial_confirmation_pair.invalid, to: decision_missing.initial_confirmation }
    - { from: revision_confirmation_pair.ready, to: final_confirmation_pair.revision }
    - { from: revision_confirmation_pair.invalid, to: decision_missing.revision_confirmation }
    - { from: final_confirmation_pair.ready, to: verify_confirmation.reviews }
    - { from: final_confirmation_pair.invalid, to: decision_missing.final_confirmation }
    - { from: verify_confirmation.ready, to: finalize_ready.decision }
    - { from: verify_confirmation.failed, to: decision_missing.confirmation, condition: on_failure }
    - { from: finalize_ready.ready, to: ready_for_ci.result }
    - { from: finalize_ready.failed, to: finalization_failed.result, condition: on_failure }

  policies:
    max_nodes: 40
    max_edges: 44
    max_parallelism: 4
    max_dispatches: 32
    max_handoffs: 48
    max_corrections_per_node: 2
    max_edge_traversals: 4
